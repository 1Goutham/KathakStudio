# Copy to .env.local for local testing, or add these in Vercel → Project → Settings → Environment Variables.
# Configure ONE provider. With neither, the form falls back to opening WhatsApp pre-filled.

# Option A: CallMeBot (free; notifies your own WhatsApp number)
CALLMEBOT_APIKEY=

# Option B: WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=new_enquiry
WHATSAPP_TEMPLATE_LANG=en

# Optional: send enquiries somewhere other than the studio number (international format, no +)
ENQUIRY_WHATSAPP_TO=
